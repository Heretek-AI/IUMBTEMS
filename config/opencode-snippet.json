{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "iumbtems": {
      "type": "local",
      "command": ["python3", "<IUMBTEMS_ROOT>/runner/mcp_server.py"],
      "enabled": true
    }
  },
  "plugins": [
    {
      "package": "@heretek-ai/epistemic-swarm",
      "options": {
        "search_engine": "duckduckgo",
        "max_iterations": 2,
        "mode": "research"
      }
    }
  ],
  "agent": {
    "code-auditor": {
      "description": "IUMBTEMS Codebase Auditor: Dialectic architecture mapping and vulnerability red-teaming with line-level proof.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_code_audit": true,
        "iumbtems_config": true
      }
    },
    "oss-scout": {
      "description": "IUMBTEMS Open Source Scout: Discovers mature OSS packages, audits copyleft licensing, and generates clean-room blueprints.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_oss_scout": true,
        "iumbtems_config": true
      }
    },
    "alpha-thesis": {
      "description": "IUMBTEMS Proponent Agent: Gathers corroborating primary sources, benchmark results, and empirical proofs.",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "task": true,
        "iumbtems_swarm_research": true,
        "iumbtems_verify_quote": true,
        "iumbtems_config": true
      }
    },
    "beta-redteam": {
      "description": "IUMBTEMS Adversary Agent: Active falsification, red-teaming, hunting for counter-benchmarks, and edge-case failure modes.",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "task": true,
        "iumbtems_swarm_research": true,
        "iumbtems_verify_quote": true
      }
    },
    "epistemic-auditor": {
      "description": "IUMBTEMS Synthesizer & Auditor: Verifies verbatim source quotes, downgrades unverified claims, and calculates divergence.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_verify_quote": true
      }
    },
    "brainstormer": {
      "description": "IUMBTEMS Lateral Brainstormer: divergent what-if features, paradigm inversions, falsifiable spikes (never bug fixes).",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_brainstorm": true,
        "iumbtems_config": true
      }
    },
    "darkharvester": {
      "description": "IUMBTEMS Competitor Teardown: seed plus expand, product plus code matrix, per-feature harvest verdicts with SPDX attribution.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_darkharvest": true,
        "iumbtems_verify_quote": true,
        "iumbtems_config": true
      }
    },
    "manager": {
      "description": "IUMBTEMS Factory Manager: grill-gated phased builds. Owns gates, swarm dispatch, roadmap synthesis, QA tiebreaks. Never writes code.",
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": {
          "*": "deny",
          "factory-*": "allow",
          "programmer": "allow",
          "qa-a": "allow",
          "qa-b": "allow",
          "brainstormer": "allow",
          "darkharvester": "allow"
        }
      },
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "task": true,
        "iumbtems_brainstorm": true,
        "iumbtems_darkharvest": true,
        "iumbtems_verify_quote": true,
        "iumbtems_socratic_frontier": true,
        "iumbtems_config": true
      }
    },
    "programmer": {
      "description": "IUMBTEMS Factory Programmer: implements exactly one phase brief per spawn. Cites phase evidence hashes. Never invokes swarms or other programmers.",
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "task": {
          "*": "deny"
        }
      },
      "tools": {
        "read": true,
        "write": true,
        "bash": true,
        "grep": true,
        "glob": true,
        "iumbtems_verify_quote": true
      }
    },
    "qa-a": {
      "description": "IUMBTEMS Factory QA (functional): verifies phase acceptance criteria pass on the real surface. Read-only plus test execution. Diverged prompt from qa-b.",
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": {
          "*": "deny"
        }
      },
      "tools": {
        "read": true,
        "bash": true,
        "grep": true,
        "glob": true
      }
    },
    "qa-b": {
      "description": "IUMBTEMS Factory QA (adversarial): hunts edge cases, regressions, and acceptance loopholes the functional pass missed. Read-only plus test execution. Diverged prompt from qa-a.",
      "mode": "subagent",
      "temperature": 0.4,
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "task": {
          "*": "deny"
        }
      },
      "tools": {
        "read": true,
        "bash": true,
        "grep": true,
        "glob": true
      }
    }
  },
  "skills": {
    "paths": [
      "./skills/grilling",
      "./skills/research_cache",
      "./skills/epistemic_search",
      "./skills/swarm_config",
      "./skills/code_audit",
      "./skills/oss_scout",
      "./skills/brainstorming",
      "./skills/darkharvest",
      "./skills/factory"
    ]
  }
}
