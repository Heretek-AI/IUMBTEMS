{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "iumbtems": {
      "type": "local",
      "command": ["python3", "<IUMBTEMS_ROOT>/runner/mcp_server.py"],
      "enabled": true
    }
  },
  "plugin": [
    [
      "@heretek-ai/epistemic-swarm",
      {
        "search_engine": "duckduckgo",
        "max_iterations": 2,
        "mode": "research"
      }
    ]
  ],
  "agent": {
    "code-auditor": {
      "description": "IUMBTEMS Codebase Auditor: Dialectic architecture mapping and vulnerability red-teaming with line-level proof.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_code_audit": true,
        "iumbtems_config": true
      }
    },
    "oss-scout": {
      "description": "IUMBTEMS Open Source Scout: Discovers mature OSS packages, audits copyleft licensing, and generates clean-room blueprints.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_oss_scout": true,
        "iumbtems_config": true
      }
    },
    "alpha-thesis": {
      "description": "IUMBTEMS Proponent Agent: Gathers corroborating primary sources, benchmark results, and empirical proofs.",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "task": true,
        "iumbtems_swarm_research": true,
        "iumbtems_verify_quote": true,
        "iumbtems_config": true
      }
    },
    "beta-redteam": {
      "description": "IUMBTEMS Adversary Agent: Active falsification, red-teaming, hunting for counter-benchmarks, and edge-case failure modes.",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "task": true,
        "iumbtems_swarm_research": true,
        "iumbtems_verify_quote": true
      }
    },
    "epistemic-auditor": {
      "description": "IUMBTEMS Synthesizer & Auditor: Verifies verbatim source quotes, downgrades unverified claims, and calculates divergence.",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_verify_quote": true
      }
    },
    "brainstormer": {
      "description": "IUMBTEMS Lateral Brainstormer: divergent what-if features, paradigm inversions, falsifiable spikes (never bug fixes).",
      "tools": {
        "read": true,
        "write": true,
        "grep": true,
        "glob": true,
        "iumbtems_brainstorm": true,
        "iumbtems_config": true
      }
    }
  },
  "skills": {
    "paths": [
      "./skills/grilling",
      "./skills/research_cache",
      "./skills/epistemic_search",
      "./skills/swarm_config",
      "./skills/code_audit",
      "./skills/oss_scout",
      "./skills/brainstorming"
    ]
  }
}
