    "PREPRINT": 0.3,
    "SECONDARY_MEDIA": 0.2
  },
  "negBonus": 0.5,
  "rejectPenalty": 2.5,
  "acceptThreshold": 0.7,
  "bannedDomains": ["predatory-journal.example", "retracted-mirror.example", "banned-preprint-mirror.example"],
  "mandatoryTags": ["VERIFIED", "INFERRED", "HYPOTHESIS", "NEGATIVE_KNOWLEDGE"],
  "retractionPolicy": "zero_tolerance",
  "exportTemplate": "regulatory"
}
