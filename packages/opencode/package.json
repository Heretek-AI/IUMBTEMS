{
  "name": "@heretek-ai/epistemic-swarm",
  "version": "1.5.0",
  "esRelease": {
    "order": 3
  },
  "description": "Epistemic Swarm: an AI build factory for OpenCode v2 \u2014 grill, research, spec, build, QA and release, gated mechanically.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heretek-AI/IUMBTEMS.git",
    "directory": "packages/opencode"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./server": {
      "types": "./server.ts",
      "default": "./server.ts"
    },
    "./tui": {
      "types": "./tui.tsx",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./rpc.ts",
      "default": "./rpc.ts"
    }
  },
  "files": [
    "index.ts",
    "server.ts",
    "tui.tsx",
    "rpc.ts",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bun script/build-tui.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@heretek-ai/es-core": "workspace:*",
    "@opencode/plugin": "2.0.24"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-typescript": "7.27.1",
    "@heretek-ai/es-testkit": "workspace:*",
    "@opencode/sdk": "2.0.24",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.15"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
