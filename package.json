    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22", "bun": ">=1.4" }
}
