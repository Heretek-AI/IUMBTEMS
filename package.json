{
  "name": "epistemic-swarm-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test ./packages",
    "typecheck": "for p in core testkit opencode cli; do tsc -p packages/$p/tsconfig.json --noEmit --composite false || exit 1; done",
    "lint": "biome check .",
    "deps:check": "bun scripts/deps.ts",
    "evals": "bun scripts/evals.ts",
    "format": "biome format --write .",
    "check": "bun run lint && bun run deps:check && bun run typecheck && bun run test",
    "docs:gen": "bun scripts/docs.ts",
    "docs:check": "bun scripts/docs.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  }
}
