{
  "epistemic-query-interceptor": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 antigravity_hooks.py pre_tool || echo '{\"decision\": \"allow\"}'",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 antigravity_hooks.py pre_invocation || echo '{}'",
        "timeout": 15
      }
    ]
  },
  "epistemic-claim-auditor": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 antigravity_hooks.py post_tool || echo '{}'",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 antigravity_hooks.py stop || echo '{\"decision\": \"allow\"}'",
        "timeout": 20
      }
    ]
  }
}
