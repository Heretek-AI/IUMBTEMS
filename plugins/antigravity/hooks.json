{
  "epistemic-query-interceptor": {
    "PreToolUse": [
      {
        "matcher": "search_web|read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/../../runner/antigravity_hooks.py\" pre_tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"${extensionPath}/../../runner/antigravity_hooks.py\" pre_invocation",
        "timeout": 15
      }
    ]
  },
  "epistemic-claim-auditor": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/../../runner/antigravity_hooks.py\" post_tool",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"${extensionPath}/../../runner/antigravity_hooks.py\" stop",
        "timeout": 20
      }
    ]
  }
}
