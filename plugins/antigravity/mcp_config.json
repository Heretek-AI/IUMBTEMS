{
  "mcpServers": {
    "brave-search": {
      "command": "python3",
      "args": ["${pluginPath}/../../config/mcp_launcher.py", "brave-search"],
      "env": {
        "BRAVE_SEARCH_API_KEY": "${BRAVE_SEARCH_API_KEY}"
      }
    },
    "firecrawl": {
      "command": "python3",
      "args": ["${pluginPath}/../../config/mcp_launcher.py", "firecrawl"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "FIRECRAWL_API_URL": "${FIRECRAWL_API_URL:-http://localhost:3002}"
      }
    },
    "searxng": {
      "command": "python3",
      "args": ["${pluginPath}/../../config/mcp_launcher.py", "searxng"],
      "env": {
        "SEARXNG_URL": "${SEARXNG_URL:-http://localhost:8080}"
      }
    },
    "iumbtems": {
      "command": "python3",
      "args": ["${pluginPath}/../../runner/mcp_server.py"],
      "env": {
        "PYTHONPATH": "${pluginPath}/../.."
      }
    }
  }
}
