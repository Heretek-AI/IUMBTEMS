{
  "mcpServers": {
    "iumbtems": {
      "command": "python3",
      "args": ["${extensionPath}/mcp_launcher.py", "iumbtems"],
      "env": {
        "IUMBTEMS_WORKSPACE": "${workspacePath}"
      }
    },
    "brave-search": {
      "command": "python3",
      "args": ["${extensionPath}/mcp_launcher.py", "brave-search"],
      "env": {
        "BRAVE_SEARCH_API_KEY": "${BRAVE_SEARCH_API_KEY}"
      }
    },
    "firecrawl": {
      "command": "python3",
      "args": ["${extensionPath}/mcp_launcher.py", "firecrawl"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "FIRECRAWL_API_URL": "${FIRECRAWL_API_URL:-https://api.firecrawl.dev}"
      }
    },
    "searxng": {
      "command": "python3",
      "args": ["${extensionPath}/mcp_launcher.py", "searxng"],
      "env": {
        "SEARXNG_URL": "${SEARXNG_URL:-http://localhost:8080}"
      }
    }
  }
}
