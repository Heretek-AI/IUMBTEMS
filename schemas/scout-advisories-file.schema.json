{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "object",
      "properties": {
        "ecosystem": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "ecosystem",
        "package"
      ],
      "additionalProperties": false
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string"
          },
          "fixed": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "summary",
          "aliases",
          "fixed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "query",
    "advisories"
  ],
  "additionalProperties": false
}
