{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "gate",
        "audit",
        "qa",
        "replan",
        "eval"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "seat": {
      "type": "string",
      "minLength": 1
    },
    "occurrences": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "key",
    "kind",
    "label",
    "occurrences",
    "runIds",
    "evidence"
  ],
  "additionalProperties": false
}
