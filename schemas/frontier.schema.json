{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.1",
      "type": "string",
      "const": "1.1"
    },
    "idea": {
      "type": "string",
      "minLength": 1
    },
    "spendCeiling": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "maxAmount": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "currency",
        "maxAmount"
      ],
      "additionalProperties": false
    },
    "settled": {
      "default": false,
      "type": "boolean"
    },
    "round": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "string"
          },
          "kind": {
            "default": "decision",
            "type": "string",
            "enum": [
              "decision",
              "fact"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          },
          "status": {
            "default": "open",
            "type": "string",
            "enum": [
              "open",
              "settled",
              "deferred"
            ]
          },
          "round": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "kind",
          "question",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "version",
    "idea",
    "spendCeiling",
    "settled",
    "round",
    "nodes"
  ],
  "additionalProperties": false
}
