{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pcrbVersion": {
      "type": "string",
      "const": "1.1"
    },
    "objective": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string"
    },
    "synthesis": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tag": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "INFERRED",
              "HYPOTHESIS",
              "NEGATIVE_KNOWLEDGE"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "default": "LIVE",
            "type": "string",
            "enum": [
              "LIVE",
              "STALE",
              "SUSPECT",
              "REJECTED"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "sha256",
              "quote"
            ],
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "lines",
              "excerpt"
            ],
            "additionalProperties": false
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "reasoning": {
            "type": "string"
          },
          "falsification": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "witness": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "checkedAt": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "checkedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tag",
          "statement",
          "status",
          "witness"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "retrieved": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "retrieved",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "synthesis": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claims": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "synthesis",
        "claims",
        "sources",
        "members"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "hmac-sha256"
        },
        "keyId": {
          "type": "string"
        },
        "mac": {
          "type": "string"
        }
      },
      "required": [
        "alg",
        "keyId",
        "mac"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "pcrbVersion",
    "objective",
    "exportedAt",
    "synthesis",
    "claims",
    "sources",
    "manifest",
    "signature"
  ],
  "additionalProperties": false
}
