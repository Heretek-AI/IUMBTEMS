{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "research",
        "code-audit",
        "oss-scout"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tag": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "INFERRED",
              "HYPOTHESIS",
              "NEGATIVE_KNOWLEDGE"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "default": "LIVE",
            "type": "string",
            "enum": [
              "LIVE",
              "STALE",
              "SUSPECT",
              "REJECTED"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sha256",
              "quote"
            ],
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "lines",
              "excerpt"
            ],
            "additionalProperties": false
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "reasoning": {
            "type": "string"
          },
          "falsification": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "witness": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "checkedAt": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "checkedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tag",
          "statement",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "verdicts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "at": {
            "type": "string"
          },
          "notes": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "by",
          "verdict",
          "at",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "version",
    "mode",
    "subject",
    "createdAt",
    "claims",
    "verdicts",
    "evidenceHash"
  ],
  "additionalProperties": false
}
