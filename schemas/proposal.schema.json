{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "prompt-guidance",
        "gate-tuning",
        "domain-pack"
      ]
    },
    "cluster": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "gate",
            "audit",
            "eval"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "key",
        "kind",
        "label",
        "occurrences",
        "runIds",
        "evidence"
      ],
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "kind",
    "cluster",
    "rationale",
    "files"
  ],
  "additionalProperties": false
}
