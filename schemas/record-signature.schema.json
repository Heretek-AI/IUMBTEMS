{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "alg": {
      "type": "string",
      "const": "ed25519"
    },
    "keyId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16
    },
    "sig": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "alg",
    "keyId",
    "sig"
  ],
  "additionalProperties": false
}
