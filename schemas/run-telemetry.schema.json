{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "halt": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "from": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "from"
      ],
      "additionalProperties": false
    },
    "spend": {
      "type": "object",
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "estimated": {
          "type": "boolean"
        },
        "events": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "usd",
        "estimated",
        "events"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "replanned": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status",
          "failures",
          "replanned"
        ],
        "additionalProperties": false
      }
    },
    "gateRejections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "rule",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "auditFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "severity",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "auditChain": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "valid": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "entries",
        "valid"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "mode",
    "stage",
    "spend",
    "phases",
    "gateRejections",
    "auditFindings",
    "auditChain"
  ],
  "additionalProperties": false
}
