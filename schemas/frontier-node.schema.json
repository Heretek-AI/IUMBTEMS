{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string"
    },
    "kind": {
      "default": "decision",
      "type": "string",
      "enum": [
        "decision",
        "fact"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    },
    "status": {
      "default": "open",
      "type": "string",
      "enum": [
        "open",
        "settled",
        "deferred"
      ]
    },
    "round": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "kind",
    "question",
    "status"
  ],
  "additionalProperties": false
}
