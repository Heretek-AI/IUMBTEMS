{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "brief": {
      "type": "object",
      "properties": {
        "idea": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "idea"
      ],
      "additionalProperties": false
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ideas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lens": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          },
          "duplicateOf": {
            "type": "string"
          },
          "similarity": {
            "type": "number"
          },
          "recordedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "lens",
          "title",
          "text",
          "recordedAt"
        ],
        "additionalProperties": false
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "duplicateOf": {
            "type": "string"
          },
          "similarity": {
            "type": "number"
          },
          "lens": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "duplicateOf",
          "similarity",
          "lens",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "ranked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "total"
        ],
        "additionalProperties": false
      }
    },
    "shortlist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "total": {
            "type": "number"
          },
          "outlier": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "total",
          "outlier"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priorArt": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "novel",
              "similar",
              "existing"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "relation"
        ],
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "lenses": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ideas": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "duplicates": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "scored": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lenses",
        "ideas",
        "duplicates",
        "scored"
      ],
      "additionalProperties": false
    },
    "completedAt": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "brief",
    "lenses",
    "ideas",
    "duplicates",
    "ranked",
    "shortlist",
    "coverage",
    "gaps",
    "stats",
    "completedAt"
  ],
  "additionalProperties": false
}
