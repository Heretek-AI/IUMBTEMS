{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string"
    },
    "modelLimited": {
      "type": "boolean"
    }
  },
  "required": [
    "case",
    "pass",
    "failures",
    "steps"
  ],
  "additionalProperties": false
}
