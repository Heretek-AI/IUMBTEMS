{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "manifest",
  "type": "object",
  "required": [
    "session_id",
    "objective",
    "status",
    "scopes"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "plugin_version": {
      "type": "string"
    },
    "backend": {
      "type": "string"
    },
    "preflight": {
      "type": "object"
    },
    "scopes": {
      "type": "array"
    },
    "telemetry": {
      "type": "object"
    }
  }
}
