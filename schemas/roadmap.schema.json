{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "baseBranch": {
      "type": "string"
    },
    "phases": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "dependsOn"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "phases"
  ],
  "additionalProperties": false
}
