{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidate": {
      "type": "string"
    },
    "stars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastRelease": {
      "type": "string"
    },
    "releasesPerYear": {
      "type": "number",
      "minimum": 0
    },
    "maintenance": {
      "type": "string",
      "enum": [
        "vibrant",
        "stable",
        "slow",
        "abandoned"
      ]
    },
    "advisories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "aliases": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string"
          },
          "fixed": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "summary",
          "aliases",
          "fixed"
        ],
        "additionalProperties": false
      }
    },
    "proposal": {
      "type": "string",
      "enum": [
        "adopt",
        "clean-room",
        "reject"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 8
    },
    "blueprint": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tag": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "INFERRED",
              "HYPOTHESIS",
              "NEGATIVE_KNOWLEDGE"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "default": "LIVE",
            "type": "string",
            "enum": [
              "LIVE",
              "STALE",
              "SUSPECT",
              "REJECTED"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "sha256",
              "quote"
            ],
            "additionalProperties": false
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "lines",
              "excerpt"
            ],
            "additionalProperties": false
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "reasoning": {
            "type": "string"
          },
          "falsification": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "nkKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "witness": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "checkedAt": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "checkedAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tag",
          "statement",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "recordedAt": {
      "type": "string"
    }
  },
  "required": [
    "candidate",
    "maintenance",
    "advisories",
    "proposal",
    "rationale",
    "claims",
    "recordedAt"
  ],
  "additionalProperties": false
}
