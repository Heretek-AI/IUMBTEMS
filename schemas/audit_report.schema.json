{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "audit_report",
  "type": "object",
  "required": [
    "scope_id",
    "summary"
  ],
  "properties": {
    "auditor": {
      "type": "string"
    },
    "scope_id": {
      "type": "string"
    },
    "audited_at": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "verified_passed",
        "unverified_rejected",
        "divergence_score",
        "verdict"
      ],
      "properties": {
        "total_claims_audited": {
          "type": "integer"
        },
        "verified_passed": {
          "type": "integer"
        },
        "unverified_rejected": {
          "type": "integer"
        },
        "negative_knowledge_count": {
          "type": "integer"
        },
        "dropped_malformed_nk": {
          "type": "integer"
        },
        "epistemic_score": {
          "type": "number"
        },
        "divergence_score": {
          "type": "number"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocking_findings": {
          "type": "integer"
        },
        "verdict": {
          "type": "string"
        }
      }
    },
    "alpha_claims_audit": {
      "type": "array"
    },
    "beta_claims_audit": {
      "type": "array"
    },
    "divergence_matrix": {
      "type": "array"
    },
    "harvest_findings": {
      "type": "array"
    },
    "degradation": {
      "type": "object"
    }
  }
}
