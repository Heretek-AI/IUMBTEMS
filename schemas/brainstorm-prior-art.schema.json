{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "relation": {
      "type": "string",
      "enum": [
        "novel",
        "similar",
        "existing"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "url",
    "relation"
  ],
  "additionalProperties": false
}
